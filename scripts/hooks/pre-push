#!/bin/sh
# Pre-push hook: run the gate steps in order, refuse the push on the
# first failure. The three steps are:
#
#   1. `make verify` — build + lint + test + complexity (the
#      pre-merge gate documented in CLAUDE.md).
#   2. `make coverage-affected` — narrows AST-aware strip + the
#      inverted per-file floor to crates whose code (or rev-deps)
#      changed since `origin/main`. Falls back to `make coverage`
#      (full workspace) when the affected-crates script signals
#      `__FULL__` (e.g. Cargo.lock / Makefile / coverage tooling
#      changes), and skips coverage entirely on `__NONE__` (docs,
#      `.github/**`, etc).
#
# Installation:
#   git config core.hooksPath scripts/hooks    # one-time, per checkout
#   # or `make install-hooks` which does the same thing.
#
# Bypass (rare, intentional):
#   git push --no-verify
#
# Bypass to force the full workspace coverage run regardless of the
# diff (e.g. before a release tag, or to reproduce a CI green on
# `push: main`):
#   LNS_PREPUSH_FULL_COVERAGE=1 git push
#
# This hook receives push refs on stdin (`<local-ref> <local-sha>
# <remote-ref> <remote-sha>`) but doesn't read them — we gate every
# push uniformly. If a caller pushes a deletion-only ref, the gate
# still runs; that's intentional symmetry with the pre-merge gate.

set -eu

# Run from the repo root so the Makefiles' relative paths resolve.
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

run_step() {
    step=$1
    printf '\033[1;33m▶\033[0m  pre-push: running `make %s`…\n' "$step"
    if ! make "$step"; then
        printf '\033[1;31m✗\033[0m  pre-push: `make %s` failed. Push refused.\n' "$step" >&2
        printf '   To bypass (rare, intentional): git push --no-verify\n' >&2
        exit 1
    fi
}

run_step lint
run_step complexity

# Refresh origin/main so `affected-crates.sh` (used by
# `make coverage-affected`) compares against the freshest base. A
# stale local origin/main would mis-classify diffs and risk a false
# `__NONE__` skip. If the fetch fails (offline, auth), we still let
# the script run — its detached-HEAD / no-merge-base fallback emits
# `__FULL__`, which is the safe-by-default outcome for the gate.
if [ "${LNS_PREPUSH_FULL_COVERAGE:-0}" != "1" ]; then
    printf '\033[1;33m▶\033[0m  pre-push: refreshing origin/main for affected-crates base…\n'
    git fetch --quiet origin main:refs/remotes/origin/main 2>/dev/null \
        || printf '   (fetch failed; affected-crates.sh fallback will apply)\n' >&2
fi

if [ "${LNS_PREPUSH_FULL_COVERAGE:-0}" = "1" ]; then
    coverage_target="coverage"
    coverage_label="full workspace (LNS_PREPUSH_FULL_COVERAGE=1)"
else
    coverage_target="coverage-affected"
    coverage_label="affected crates only (set LNS_PREPUSH_FULL_COVERAGE=1 for full workspace)"
fi

printf '\033[1;33m▶\033[0m  pre-push: running `make %s` [%s]…\n' \
    "$coverage_target" "$coverage_label"
if ! make "$coverage_target"; then
    printf '\033[1;31m✗\033[0m  pre-push: coverage gate failed. Push refused.\n' >&2
    printf '   Either bring the file to 100%% or add it to IGNORES in\n' >&2
    printf '   scripts/coverage-floor.sh with a one-line reason\n' >&2
    printf '   explaining why it is intentionally exempt.\n' >&2
    printf '   To force the full workspace run (e.g. to reproduce a\n' >&2
    printf '   CI failure on `push: main`):\n' >&2
    printf '     LNS_PREPUSH_FULL_COVERAGE=1 git push\n' >&2
    printf '   To bypass entirely (rare, intentional): git push --no-verify\n' >&2
    exit 1
fi

printf '\033[1;32m✓\033[0m  pre-push: gate green. Pushing.\n'
