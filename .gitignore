node_modules
target
dist
.DS_Store
coverage
*.log

# Gate bookkeeping: the per-worktree coverage stamp and detail handoff.
# The timing log lives in the shared git dir, which is never tracked.
.gate/

# Per-package build artifacts
bin/

# Claude Code local settings
.claude/settings.local.json

# Editor
.vscode/
.idea/

# Per-developer environment (direnv; local build-time OAuth client ids)
.envrc
.env.local

# Worktrees
.claude/worktrees/

# Pruner skill's local index cache
.pruner/

# LLVM source-based coverage output. cargo-llvm-cov writes `.profraw`
# files per instrumented process and merges them into `.profdata` via
# `cargo llvm-cov report`. Both are transient build artifacts.
*.profraw
*.profdata

# Harness-generated per-directory decisions files; never commit personal grants.
lns-policy.yaml
