node_modules
target
target-cov
dist
.DS_Store
coverage
*.log

# Per-package build artifacts
bin/

# Auto-created when running `lns`; a runtime artifact, not source. The e2e
# harness boots real runs with the crate dir as cwd (make e2e-microvm).
/lns-policy.yaml
/crates/e2e-tests/lns-policy.yaml

# Claude Code local settings
.claude/settings.local.json

# Editor
.vscode/
.idea/

# Per-developer environment (direnv; local build-time OAuth client ids)
.envrc
.env.local

# Worktrees
.claude/worktrees/

# Pruner skill's local index cache
.pruner/

# LLVM source-based coverage output. cargo-llvm-cov writes `.profraw`
# files per instrumented process and merges them into `.profdata` via
# `cargo llvm-cov report`. Both are transient build artifacts.
*.profraw
*.profdata

# Per-developer agent tooling and code-review scratch (not shipped with the repo)
.agents/
.codex/
.code-reviews/
