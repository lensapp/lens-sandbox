{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "label": "autorelease: pending,release",
  "release-label": "autorelease: tagged,release",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "lns",
      "components": ["lns", "lns-cli", "lns-service", "e2e-tests"]
    }
  ],
  "exclude-paths": [
    ".github",
    ".husky",
    ".vscode",
    "docs"
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "lns",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "exclude-paths": [
        ".github",
        ".husky",
        ".vscode",
        "docs",
        "scripts/lns-install",
        "crates/e2e-tests",
        "crates/bump-kernel",
        "crates/coverage-strip-ast"
      ]
    },
    "crates/lns-cli": {
      "release-type": "rust",
      "component": "lns-cli",
      "bump-minor-pre-major": true,
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/lns-service": {
      "release-type": "rust",
      "component": "lns-service",
      "bump-minor-pre-major": true,
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/e2e-tests": {
      "release-type": "rust",
      "component": "e2e-tests",
      "bump-minor-pre-major": true,
      "skip-github-release": true,
      "skip-changelog": true
    },
    "scripts/lns-install": {
      "release-type": "simple",
      "component": "lns-install",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "lns-install.sh"
        }
      ]
    }
  }
}
