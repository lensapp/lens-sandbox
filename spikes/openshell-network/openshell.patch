+pub async fn resolve_dns_upstream(
+    server: SocketAddr,
+    name: &str,
+    ipv6: bool,
+    exchange_timeout: Duration,
+) -> Result<Vec<IpAddr>> {
+    use crate::policy_dns::{
+        AddressFamily, NormalizedName, SocketTrustedResolver, TrustedResolver,
+    };
+    let name = NormalizedName::parse(name).map_err(|_| miette::miette!("invalid DNS name"))?;
+    let family = if ipv6 {
+        AddressFamily::Ipv6
+    } else {
+        AddressFamily::Ipv4
+    };
+    let resolver = SocketTrustedResolver::with_timeout(server, exchange_timeout);
+    resolver
+        .resolve(&name, family)
+        .await
+        .map(|answer| answer.addresses)
+        .map_err(|error| miette::miette!("{error}"))
+}
