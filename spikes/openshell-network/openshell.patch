+    pub fn authorize_connection(&self, input: &NetworkInput) -> Result<EgressAuthorization> {
+        let original = self.authorize_egress(input)?;
+        if matches!(original.action, NetworkAction::Allow { .. }) {
+            return Ok(original);
+        }
+        let approver = self
+            .connection_approver
+            .read()
+            .map_err(|_| miette::miette!("connection approver lock poisoned"))?
+            .clone();
+        if !approver.is_some_and(|approve| approve(input, &original.action)) {
+            return Ok(original);
+        }
+        let mut current = self.authorize_egress(input)?;
+        if current.action == original.action {
+            current.action = NetworkAction::Allow {
+                matched_policy: Some("connection-approval".into()),
+            };
+        }
+        Ok(current)
+    }
