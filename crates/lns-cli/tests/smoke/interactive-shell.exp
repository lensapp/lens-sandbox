#!/usr/bin/expect -f
# Smoke test for `lns run -it` interactive shell behaviors.
#
# Locks in four user-facing contracts that any change touching the
# interactive-shell transport (stdio pumps, chord detector, lns-init
# PTY plumbing, future session broker) must preserve:
#
#   1. The shell prompt appears and accepts input — `echo hi` echoes
#      `hi` on its own line.
#   2. Ctrl+C inside the shell does NOT detach. The guest kernel's
#      TTY line discipline echoes `^C` and the shell reprompts.
#   3. The Docker-style chord (`Ctrl+P` `Ctrl+Q`) detaches: `lns`
#      returns 0 and the run keeps executing in the background. No
#      SIGHUP is sent to the workload (an earlier revision sent
#      SIGHUP and reported 129 — terminate-and-exit, not detach).
#   4. The detached run is still listed by `lns ps` and
#      `lns sandbox attach` re-joins its shell.
#
# Run with `expect -f crates/lns-cli/tests/smoke/interactive-shell.exp`
# from the workspace root. Requires `/usr/bin/expect` (pre-installed
# on macOS) and a working Vz host. NOT in the pre-merge gate — it
# needs a live microVM, which regular `cargo test` cannot provide.

set timeout 120
log_user 1

# Resolve repo root from this script's location: $repo/crates/lns-cli/tests/smoke/.
set script_dir [file dirname [file normalize $argv0]]
set repo_root  [file normalize "$script_dir/../../../.."]
set wrapper    "$repo_root/scripts/lns-cli.sh"

if {![file executable $wrapper]} {
    puts "FAIL: $wrapper missing or not executable"
    exit 1
}

# A plain image REF is refused, so author a throwaway sandbox definition over the e2e suite's rate-limit-safe alpine mirror.
set project [exec mktemp -d]
set def [open "$project/lns.yaml" w]
puts $def "apiVersion: lns.run/v1"
puts $def "kind: Sandbox"
puts $def "metadata:"
puts $def "  name: detach-smoke"
puts $def "spec:"
puts $def "  image: public.ecr.aws/docker/library/alpine:3.20"
close $def

spawn $wrapper run --name detach-smoke $project -- sh

# --- (1) shell comes up and echoes a command ------------------------------

expect {
    timeout {
        puts "\nFAIL: timed out waiting for initial shell prompt"
        exit 1
    }
    -re {[/~] [#$] }
}

set timeout 15
send "echo hi\r"
expect {
    timeout {
        puts "\nFAIL: `echo hi` produced no output on its own line"
        exit 1
    }
    -re "\nhi\r"
}
expect {
    timeout {
        puts "\nFAIL: no prompt after `echo hi`"
        exit 1
    }
    -re {[/~] [#$] }
}

# --- (2) Ctrl+C must reprompt, NOT detach --------------------------------

send "\x03"
expect {
    timeout {
        puts "\nFAIL: Ctrl+C did not produce `^C` echo from the guest TTY"
        exit 1
    }
    -exact "^C"
}
expect {
    timeout {
        puts "\nFAIL: shell did not reprompt after Ctrl+C — chord may have absorbed it"
        exit 1
    }
    -re {[/~] [#$] }
}

# --- (3) Ctrl+P Ctrl+Q detaches, leaving the run running -----------------

send "\x10\x11"
set timeout 30
expect {
    timeout {
        puts "\nFAIL: chord did not detach within 30s — the CLI kept relaying or the guest froze"
        exit 1
    }
    eof
}
catch wait result
set os_error_flag [lindex $result 2]
set value         [lindex $result 3]
if {$os_error_flag != 0} {
    puts "\nFAIL: OS error after chord, errno $value"
    exit 1
}
# Docker-style detach: the chord makes the CLI return 0 and leaves the
# run executing in the background. No SIGHUP is sent to the workload —
# a regression to terminate-and-exit would surface here as 129.
if {$value != 0} {
    puts "\nFAIL: expected exit 0 after docker-style detach, got $value"
    exit 1
}

# --- (4) the detached run is still listed and re-attachable --------------

set timeout 15
spawn $wrapper ps
expect {
    timeout {
        puts "\nFAIL: `lns ps` did not list the detached run"
        exit 1
    }
    "detach-smoke"
}
catch wait

spawn $wrapper sandbox attach detach-smoke
# Attach follows from the tail (no history replay), so an idle shell shows nothing until a keystroke provokes a fresh prompt.
send "\r"
expect {
    timeout {
        puts "\nFAIL: `lns sandbox attach` did not re-join the detached run's shell"
        exit 1
    }
    -re {[/~] [#$] }
}
send "echo rejoined\r"
expect {
    timeout {
        puts "\nFAIL: re-attached shell produced no output"
        exit 1
    }
    -re "\nrejoined\r"
}
# Detach again (still no signal), then tear the run down explicitly.
send "\x10\x11"
expect eof
catch wait

spawn $wrapper sandbox kill detach-smoke
expect eof
catch wait

puts "\nPASS: interactive shell behaviors all green (docker-style detach + re-attach confirmed)"
exit 0
