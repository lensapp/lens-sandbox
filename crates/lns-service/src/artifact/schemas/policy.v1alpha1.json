{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apiVersion": {
      "const": "lens.dev/v1alpha1"
    },
    "kind": {
      "const": "Policy"
    },
    "metadata": {
      "properties": {
        "labels": {
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "mount": {
      "properties": {
        "path": {
          "minLength": 1,
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "spec": {
      "properties": {
        "integrations": {
          "items": {
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "ref"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "network": {
          "properties": {
            "allowedRoutes": {
              "items": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "match": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "rules": {
                    "items": {
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "scheme": {
                    "enum": [
                      "http",
                      "https"
                    ]
                  },
                  "tlsTerminate": {
                    "type": "boolean"
                  },
                  "transport": {
                    "enum": [
                      "upstream",
                      "direct"
                    ]
                  },
                  "verdict": {
                    "enum": [
                      "allow",
                      "deny",
                      "ask"
                    ]
                  }
                },
                "required": [
                  "match",
                  "verdict"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "defaultTransport": {
              "enum": [
                "upstream",
                "direct"
              ]
            },
            "defaultVerdict": {
              "enum": [
                "allow",
                "deny",
                "ask"
              ]
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object",
  "$id": "https://lens.dev/schemas/policy.v1alpha1.json",
  "title": "Lens policy artifact (v1alpha1)",
  "x-lens-class": "runtime",
  "x-lens-config-media-type": "application/vnd.lens.policy.config.v1+json",
  "x-lens-artifact-type": "application/vnd.lens.policy.v1+json"
}
