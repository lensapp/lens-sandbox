{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apiVersion": {
      "const": "lens.dev/v1alpha1"
    },
    "kind": {
      "const": "AgentSystem"
    },
    "metadata": {
      "properties": {
        "labels": {
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "mount": {
      "properties": {
        "path": {
          "minLength": 1,
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "spec": {
      "properties": {
        "components": {
          "properties": {
            "agents": {
              "items": {
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "filesets": {
              "items": {
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "knowledge": {
              "items": {
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "model": {
              "properties": {
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "type": "object"
            },
            "policies": {
              "items": {
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "sandbox": {
              "properties": {
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "type": "object"
            },
            "tools": {
              "items": {
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "workflow": {
              "properties": {
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "components"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object",
  "$id": "https://lens.dev/schemas/bundle.v1alpha1.json",
  "title": "Lens bundle artifact (v1alpha1)",
  "x-lens-class": "runtime",
  "x-lens-config-media-type": "application/vnd.lens.bundle.config.v1+json",
  "x-lens-artifact-type": "application/vnd.lens.bundle.v1+json"
}
