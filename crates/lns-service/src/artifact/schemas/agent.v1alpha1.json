{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apiVersion": {
      "const": "lens.dev/v1alpha1"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "properties": {
        "labels": {
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "mount": {
      "properties": {
        "path": {
          "minLength": 1,
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "spec": {
      "properties": {
        "command": {
          "type": "string"
        },
        "credentials": {
          "items": {
            "properties": {
              "env": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "env"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "env": {
          "type": "object"
        },
        "image": {
          "minLength": 1,
          "type": "string"
        },
        "ports": {
          "items": {
            "properties": {
              "container": {
                "type": "integer"
              },
              "host": {
                "type": "integer"
              }
            },
            "required": [
              "container"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "volumes": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "readOnly": {
                "type": "boolean"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "target"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "image"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object",
  "$id": "https://lens.dev/schemas/agent.v1alpha1.json",
  "title": "Lens agent artifact (v1alpha1)",
  "x-lens-class": "runtime",
  "x-lens-config-media-type": "application/vnd.lens.agent.config.v1+json",
  "x-lens-artifact-type": "application/vnd.lens.agent.v1+json"
}
